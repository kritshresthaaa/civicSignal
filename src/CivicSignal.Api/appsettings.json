{
  "ConnectionStrings": {
    "CivicSignal": "Host=localhost;Port=5432;Database=civic_signal;Username=postgres;Password=postgres"
  },
  "Database": {
    "MigrateOnStartup": false,
    "DevelopmentOnly": true
  },
  "DataProtection": {
    "KeysPath": "../../var/data-protection-keys"
  },
  "Jwt": {
    "Issuer": "CivicSignal.Api",
    "Audience": "CivicSignal.Client",
    "SigningKey": "local-development-only-civic-signal-jwt-signing-key-change-me-2026",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "AccessTokenCookieName": "civicsignal_access_token",
    "RefreshTokenCookieName": "civicsignal_refresh_token"
  },
  "DemoData": {
    "Enabled": false,
    "DevelopmentOnly": true
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "../../var/uploads/incident-media",
    "PublicBasePath": "/media",
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/heic",
      "image/heif",
      "video/mp4",
      "video/quicktime",
      "audio/mpeg",
      "audio/mp4",
      "audio/ogg",
      "audio/wav",
      "audio/webm",
      "application/pdf"
    ]
  },
  "S3Storage": {
    "Endpoint": "http://localhost:9000",
    "PublicBaseUrl": "http://localhost:9000/civic-signal",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "civic-signal",
    "Region": "us-east-1",
    "Prefix": "incident-media",
    "ForcePathStyle": true
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "CivicSignal:"
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "civicsignal.incidents",
    "QueueName": "civicsignal.incidents.processing",
    "RoutingKey": "incident.submitted",
    "RetryExchangeName": "civicsignal.incidents.retry",
    "RetryQueueName": "civicsignal.incidents.retry",
    "RetryRoutingKey": "incident.retry",
    "DeadLetterExchangeName": "civicsignal.incidents.dead",
    "DeadLetterQueueName": "civicsignal.incidents.dead",
    "DeadLetterRoutingKey": "incident.dead",
    "DataImportExchangeName": "civicsignal.data-imports",
    "DataImportQueueName": "civicsignal.data-imports.processing",
    "DataImportRoutingKey": "data-import.requested",
    "DataImportRetryExchangeName": "civicsignal.data-imports.retry",
    "DataImportRetryQueueName": "civicsignal.data-imports.retry",
    "DataImportRetryRoutingKey": "data-import.retry",
    "DataImportDeadLetterExchangeName": "civicsignal.data-imports.dead",
    "DataImportDeadLetterQueueName": "civicsignal.data-imports.dead",
    "DataImportDeadLetterRoutingKey": "data-import.dead",
    "RetryDelaySeconds": 15,
    "MaxRetryAttempts": 3,
    "PrefetchCount": 4
  },
  "OpenAI": {
    "Enabled": false,
    "Model": "gpt-5.1",
    "Endpoint": "https://api.openai.com/v1/responses",
    "TimeoutSeconds": 60
  },
  "AiService": {
    "Enabled": false,
    "BaseUrl": "http://localhost:8010",
    "TimeoutSeconds": 30,
    "UseRemoteEmbeddings": true
  },
  "TextEmbeddings": {
    "Dimensions": 1024
  },
  "DuplicateDetection": {
    "SearchRadiusMeters": 500,
    "TimeWindowHours": 168,
    "CandidatePoolSize": 50,
    "MaxResults": 5,
    "MinimumScore": 0.7
  },
  "Nyc311": {
    "BaseUrl": "https://data.cityofnewyork.us",
    "ResourcePath": "/resource/erm2-nwe9.json",
    "TimeoutSeconds": 30,
    "DefaultLimit": 1000,
    "MaxLimit": 5000
  },
  "Weather": {
    "Enabled": true,
    "Provider": "NationalWeatherService",
    "BaseUrl": "https://api.weather.gov",
    "UserAgent": "CivicSignalAI/0.1 local-development",
    "TimeoutSeconds": 15,
    "CacheMinutes": 20
  },
  "Nominatim": {
    "Enabled": false,
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "CivicSignalAI/0.1 local-development",
    "TimeoutSeconds": 15,
    "CacheMinutes": 1440,
    "SearchLimit": 6,
    "CountryCodes": "us"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3001"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
