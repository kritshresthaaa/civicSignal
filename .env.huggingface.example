# Copy selected values into .env when you are ready to run model-backed AI.
# The first run downloads model weights and can be slow.

AI_SERVICE_INSTALL_HF_DEPS=true
AI_USE_HF_MODELS=true
AI_SERVICE_ENABLED=true
AI_SERVICE_USE_REMOTE_EMBEDDINGS=true

# Optional if you need private/gated Hugging Face models.
HUGGINGFACE_TOKEN=

# CPU-friendly starter choices. Upgrade after baseline evaluation passes.
AI_ASR_MODEL=openai/whisper-small
AI_VISION_MODEL=google/siglip-base-patch16-224
AI_VISION_TASK=zero-shot-image-classification
AI_TEXT_MODEL=facebook/bart-large-mnli
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_HF_DEVICE=-1
