NOMINATIM_USER_AGENT=CivicSignalAI/0.1 local-development
NOMINATIM_TIMEOUT_SECONDS=15
NOMINATIM_CACHE_MINUTES=1440
NOMINATIM_SEARCH_LIMIT=6
NOMINATIM_COUNTRY_CODES=us

WORKER_ENABLED=true
WORKER_POLLING_INTERVAL_SECONDS=15
WORKER_BATCH_SIZE=10
WORKER_STEP_DELAY_MILLISECONDS=250
DATA_IMPORT_WORKER_ENABLED=true
DATA_IMPORT_WORKER_POLLING_INTERVAL_SECONDS=20
DATA_IMPORT_WORKER_BATCH_SIZE=2

