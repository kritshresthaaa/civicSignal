APP_ENV=development
ASPNETCORE_ENVIRONMENT=Development
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
# Leave blank so browsers use the frontend origin and Next.js proxies API/hub/media traffic.
NEXT_PUBLIC_API_BASE_URL=
CIVIC_PROXY_API_BASE_URL=http://api:8080
CIVIC_PROXY_OBJECT_STORAGE_BASE_URL=http://minio:9000
NEXT_PUBLIC_API_PORT=5020
API_PORT=5020

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=civic_signal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_MIGRATE_ON_STARTUP=true
DATABASE_DEVELOPMENT_ONLY=true
DATA_PROTECTION_KEYS_PATH=/var/civic-signal/data-protection-keys
DEMO_DATA_ENABLED=false
DEMO_DATA_DEVELOPMENT_ONLY=true

JWT_ISSUER=CivicSignal.Api
JWT_AUDIENCE=CivicSignal.Client
JWT_SIGNING_KEY=local-development-only-civic-signal-jwt-signing-key-change-me-2026
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14
JWT_ACCESS_TOKEN_COOKIE_NAME=civicsignal_access_token
JWT_REFRESH_TOKEN_COOKIE_NAME=civicsignal_refresh_token

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ENABLED=true
REDIS_INTERNAL_CONNECTION_STRING=redis:6379
REDIS_INSTANCE_NAME=CivicSignal:

RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_INTERNAL_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_EXCHANGE=civicsignal.incidents
RABBITMQ_QUEUE=civicsignal.incidents.processing
RABBITMQ_ROUTING_KEY=incident.submitted
RABBITMQ_RETRY_EXCHANGE=civicsignal.incidents.retry
RABBITMQ_RETRY_QUEUE=civicsignal.incidents.retry
RABBITMQ_RETRY_ROUTING_KEY=incident.retry
RABBITMQ_DLQ_EXCHANGE=civicsignal.incidents.dead
RABBITMQ_DLQ_QUEUE=civicsignal.incidents.dead
RABBITMQ_DLQ_ROUTING_KEY=incident.dead
RABBITMQ_DATA_IMPORT_EXCHANGE=civicsignal.data-imports
RABBITMQ_DATA_IMPORT_QUEUE=civicsignal.data-imports.processing
RABBITMQ_DATA_IMPORT_ROUTING_KEY=data-import.requested
RABBITMQ_DATA_IMPORT_RETRY_EXCHANGE=civicsignal.data-imports.retry
RABBITMQ_DATA_IMPORT_RETRY_QUEUE=civicsignal.data-imports.retry
RABBITMQ_DATA_IMPORT_RETRY_ROUTING_KEY=data-import.retry
RABBITMQ_DATA_IMPORT_DLQ_EXCHANGE=civicsignal.data-imports.dead
RABBITMQ_DATA_IMPORT_DLQ_QUEUE=civicsignal.data-imports.dead
RABBITMQ_DATA_IMPORT_DLQ_ROUTING_KEY=data-import.dead
RABBITMQ_RETRY_DELAY_SECONDS=15
RABBITMQ_MAX_RETRY_ATTEMPTS=3
RABBITMQ_PREFETCH_COUNT=4

S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/civic-signal
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=civic-signal
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_PREFIX=incident-media
S3_FORCE_PATH_STYLE=true
FILE_STORAGE_PROVIDER=S3

HUGGINGFACE_TOKEN=
AI_SERVICE_PORT=8010
AI_SERVICE_ENABLED=true
AI_SERVICE_INSTALL_HF_DEPS=false
AI_SERVICE_BASE_URL=http://ai-service:8010
AI_SERVICE_TIMEOUT_SECONDS=30
AI_SERVICE_USE_REMOTE_EMBEDDINGS=true
AI_USE_HF_MODELS=false
AI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_ASR_MODEL=openai/whisper-small
AI_VISION_MODEL=google/siglip-base-patch16-224
AI_VISION_TASK=zero-shot-image-classification
AI_VISION_LABEL_MIN_CONFIDENCE=0.20
AI_TEXT_MODEL=facebook/bart-large-mnli
AI_HF_DEVICE=

OPENAI_API_KEY=
OpenAI__Enabled=false
OpenAI__Model=gpt-5.1
OpenAI__Endpoint=https://api.openai.com/v1/responses

TextEmbeddings__Dimensions=1024
DuplicateDetection__SearchRadiusMeters=500
DuplicateDetection__TimeWindowHours=168
DuplicateDetection__CandidatePoolSize=50
DuplicateDetection__MaxResults=5
DuplicateDetection__MinimumScore=0.7

NYC311_BASE_URL=https://data.cityofnewyork.us
NYC311_RESOURCE_PATH=/resource/erm2-nwe9.json
NYC311_APP_TOKEN=
NYC311_TIMEOUT_SECONDS=30
NYC311_DEFAULT_LIMIT=1000
NYC311_MAX_LIMIT=5000

WEATHER_ENABLED=true
WEATHER_BASE_URL=https://api.weather.gov
WEATHER_USER_AGENT=CivicSignalAI/0.1 local-development
WEATHER_TIMEOUT_SECONDS=15
WEATHER_CACHE_MINUTES=20

NOMINATIM_ENABLED=true
